# Copy to .env.local and fill in. Never commit .env.local.
#
# With FAL_MODE=mock (the default) you need no fal account and nothing is
# billed — the provider adapter returns fixture assets on a realistic delay.

# ---- Provider -------------------------------------------------------------
# mock = fixture assets, zero cost. live = real fal.ai calls, billed to
# whichever key the visitor supplies at runtime (this app is bring-your-own-key,
# so there is deliberately no FAL_KEY here).
FAL_MODE=mock

# ---- Database -------------------------------------------------------------
DATABASE_URL=postgres://thunkin:thunkin@localhost:5432/thunkin

# ---- Secrets --------------------------------------------------------------
# Encrypts the visitor's fal key at rest. 32 bytes, base64. Rotating this
# invalidates every stored key, which is a safe (if disruptive) operation.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEY=

# Signs the anonymous session cookie. Any long random string, 32+ chars.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Guards /api/internal/sweep so the reconciler cannot be driven by the public.
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
SWEEP_SECRET=

# ---- Public origin --------------------------------------------------------
# Where fal posts webhooks. Must be publicly reachable when FAL_MODE=live —
# fal permanently drops deliveries to private and loopback addresses, so use a
# tunnel (e.g. cloudflared) for local live testing rather than localhost.
PUBLIC_URL=http://localhost:3000

# ---- Object storage (AGENT-05) --------------------------------------------
# Optional until the asset pipeline lands. fal result URLs expire, so generated
# media is re-hosted here.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_HOST=
