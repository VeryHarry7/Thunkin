# Copy to .env.local and fill in. Never commit .env.local.
#
# A private, single-user service. It runs on your machine, is reached from your
# own network, and generates on one API key that you pay for.

# ---- Access ---------------------------------------------------------------
# The passphrase you type to get in. This is the entire access boundary, and
# behind it is a key that spends money — treat it like a password.
# Changing it signs every device out immediately.
APP_PASSPHRASE=

# Signs the unlock and session cookies. Any long random string, 32+ chars.
# Changing it signs every device out, which is occasionally useful.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---- Generation -----------------------------------------------------------
# mock = fixture images, costs nothing, needs no key. live = real fal calls
# billed to FAL_KEY.
FAL_MODE=mock

# Your fal API key, in `id:secret` form. Required when FAL_MODE=live; the app
# refuses to boot without it. Get one at https://fal.ai/dashboard/keys
FAL_KEY=

# ---- Database -------------------------------------------------------------
DATABASE_URL=postgres://postgres@127.0.0.1:5433/thunkin

# ---- Where this is reached -----------------------------------------------
# The address you type into a browser. Use your machine's LAN IP so your phone
# can reach it — `http://localhost:3000` works on the host only.
#
# A private address is expected: the app detects it and stops asking fal for
# webhooks it could never deliver, letting the built-in reconciler finish jobs
# instead.
PUBLIC_URL=http://127.0.0.1:3000

# ---- Internals ------------------------------------------------------------
# Guards the manual reconciler poke at /api/internal/sweep.
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
SWEEP_SECRET=
